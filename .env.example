# Скопируйте в .env — файл читается при старте, существующие переменные окружения
# имеют приоритет над ним.

# Отвечать и на вопросы, заданные в микрофон, а не только на звук из наушников.
# Нужно для тестирования: иначе пайплайн не проверить без второго человека.
# В реальном собеседовании держите выключенным — вы и сами задаёте вопросы
# интервьюеру, и на каждый из них прилетал бы ответ.
ANSWERLINE_ANSWER_FROM_MIC=1

# Тренировочный режим: ИИ сам играет интервьюера — задаёт вопросы по очередным
# темам, вы отвечаете голосом или текстом, ИИ оценивает ответ по базе знаний.
# Отдельный модуль, обычный пайплайн собеседования не меняет: без этой
# переменной тренировочного интерфейса нет ни в UI, ни в IPC.
# В реальном собеседовании держите выключенным.
ANSWERLINE_TRAINING_MODE=1

# Где тренажёр берёт вопросы. По умолчанию data/ рядом с приложением (в
# собранной версии — resources/data). Укажите путь, если корпус лежит в
# другом месте; без него вопросы генерирует модель, а не берутся из базы.
# ANSWERLINE_CORPUS_DIR=/path/to/answerline/data

# LLM endpoint and generation parameters used by the Electron server and all
# RAG evaluation scripts. Environment values override config.json.
LLM_PROVIDER=lmstudio
LLM_BASE_URL=http://127.0.0.1:1234
LLM_MODEL=auto
# Для ChatGPT IDE Bridge замените три строки выше на:
# LLM_PROVIDER=bridge
# LLM_BASE_URL=http://127.0.0.1:17841
# LLM_MODEL=chatgpt-web/gpt-6-sol
# LLM_REASONING_EFFORT=low  # GPT-6 Instant, no deep thinking; medium/high/xhigh optional
# Optional: bind new app sessions to a ChatGPT Project (project homepage or a chat URL).
# LLM_PROJECT_URL=https://chatgpt.com/g/g-p-<project-id>-answerline/project
# LLM_PROJECT_PROMPT_MODE=project  # project=short turn, inline=send full system rules each time
# Важно: Bridge передаёт вопрос, транскрипт и RAG evidence в ChatGPT Web.
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1
LLM_TOP_P=1
LLM_TOP_K=40
LLM_MIN_P=0.05
LLM_REPEAT_PENALTY=1.1
LLM_PRESENCE_PENALTY=0
LLM_FREQUENCY_PENALTY=0
# LLM_SEED=null

# debug | info | warn | error
# debug печатает каждый чанк аудио и вывод whisper-server — полезно, когда
# кажется, что звук не доходит.
# ANSWERLINE_LOG_LEVEL=debug

# Локальный RAG: Qdrant и OpenAI-compatible embeddings endpoint.
# Один и тот же embedding model должен использоваться для индексации и runtime-поиска.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=answerline_qa
EMBEDDING_BASE_URL=http://127.0.0.1:1234
EMBEDDING_MODEL=text-embedding-qwen3-0.6b-text-embedding
EMBEDDING_BATCH_SIZE=16
# RAG_RECREATE=1 npm.cmd run rag:index — чистая пересборка коллекции.

# Runtime retrieval (также читается Session через process.env):
# Для Bridge/GPT-6: RAG_GENERAL_TOP_K=0, RAG_PERSONAL_TOP_K=1
# (теорию модель объясняет сама, из Qdrant берём только 1 личный факт).
RAG_GENERAL_TOP_K=3
RAG_PERSONAL_TOP_K=1
# RAG_TOP_K=5  # legacy fallback для старых конфигураций
RAG_MAX_CONTEXT_TOKENS=4000
# RAG_MIN_SCORE=0.45  # устарело: score не отсекает контекстные слоты
